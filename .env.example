# PostgreSQL 18+ is required for the uuidv7() defaults in the initial migration.
PORT=8080

# Replace both placeholders with different strong secrets.
DB_ADMIN_PASSWORD=replace_with_a_long_random_hex_secret
POSTGRES_DB=social_studio
DB_USER=social_studio
DB_PASSWORD=replace_with_another_long_random_hex_secret

# Enable one or more real providers. The API tries Groq, then Gemini, then OpenRouter.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_REQUEST_TIMEOUT=20s
AI_MAX_OUTPUT_TOKENS=2048
